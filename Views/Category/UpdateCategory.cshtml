@model Category;

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Device";
}

<h1>Edit Category: @Model.Name</h1>

<div class="row">
<div class="col-md-4">
    <hr />
    <form asp-action="UpdateCategory" asp-controller="Category">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <input asp-for="CategoryId" type="hidden" />
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <br/>
        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <hr/>
        <div class="form-group">
            <input type="submit" value="Update Category" class="btn btn-primary" /> |
            <a asp-action="Index" asp-controller="Category" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </form>
    <div>

    </div>
</div>
</div>