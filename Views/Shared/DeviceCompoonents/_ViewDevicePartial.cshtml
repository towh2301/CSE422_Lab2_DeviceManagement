@model IEnumerable<Device>
<p>
    <a asp-action="Create" asp-controller="Device" class="btn btn-primary">Create</a>
</p>
<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Code)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Category)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Status)
        </th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var device in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => device.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => device.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => device.Category.Name)
            </td>
            <td>
                @if(device.Status == 1)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </td>
            <td>
                <a asp-action="Update" asp-controller="Device" asp-route-id="@device.DeviceId" class="btn btn-outline-secondary">Edit</a> |
                <a asp-action="DeleteDevice" asp-controller="Device" asp-route-id="@device.DeviceId" class="btn btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>